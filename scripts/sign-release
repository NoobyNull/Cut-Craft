#!/bin/bash
# Signs every download in DIR with Cut Craft's release key: FILE.minisig beside each FILE,
# its trusted comment "file:FILE", which the updater checks (crates/updater).
#   scripts/sign-release DIR
# The key comes from the environment, set from the repository's Actions secrets:
#   MINISIGN_SECRET_KEY   the whole secret key file `minisign -G -s cutcraft.key` made
#   MINISIGN_PASSWORD     its password
# With no key it signs nothing, unless REQUIRE_SIGNING=1 (versioned releases), when it
# fails: Cut Craft will not install an unsigned download.
set -euo pipefail
dir=${1:?usage: scripts/sign-release DIR}
if [[ -z ${MINISIGN_SECRET_KEY:-} ]]; then
    if [[ ${REQUIRE_SIGNING:-0} == 1 ]]; then
        echo "::error::MINISIGN_SECRET_KEY is not set: add it under Settings > Secrets and variables > Actions"
        exit 1
    fi
    echo "::warning::no signing key: these downloads are not signed and will not update installed copies"
    exit 0
fi
if ! command -v minisign >/dev/null; then
    sudo apt-get update -qq
    sudo apt-get install -y -qq minisign
fi
key=$(mktemp)
trap 'rm -f "$key"' EXIT
printf '%s\n' "$MINISIGN_SECRET_KEY" > "$key"
shopt -s nullglob
for file in "$dir"/*; do
    [[ -f $file && $file != *.minisig ]] || continue
    name=$(basename "$file")
    # the password on standard input: there is no terminal on a runner
    printf '%s\n' "${MINISIGN_PASSWORD:-}" | minisign -S -s "$key" -m "$file" -t "file:$name"
    echo "signed $name"
done
