#!/bin/bash
# Scaffold a command crate whose contract tests fail until it is implemented.
#   scripts/new-command draw-rectangle "Draw Rectangle" "Create Vectors" drawing/create_vectors/draw_rectangle.svg
# Then: write behaviour tests in its src/lib.rs and implement run(), and its help page. The app
# registration and the help page's header are done here.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
name="$1" label="$2" group="$3" icon="${4:-}"
dir="crates/commands/$name"
[[ -e $dir ]] && { echo "$dir already exists" >&2; exit 1; }
id="${name//-/_}"
type=$(sed -E 's/(^|-)([a-z0-9])/\U\2/g' <<<"$name")
mkdir -p "$dir/src"

cat >"$dir/Cargo.toml" <<EOF
[package]
name = "cmd-$name"
description = "$label"
version.workspace = true
edition.workspace = true

[dependencies]
cut-craft-core.workspace = true
schemars.workspace = true
serde.workspace = true

[dev-dependencies]
cut-craft-core = { workspace = true, features = ["testing"] }

[lints]
workspace = true
EOF

cat >"$dir/src/lib.rs" <<EOF
//! $label.

use cut_craft_core::document::Document;
use cut_craft_core::{Change, Command, CommandError, Meta};
use schemars::JsonSchema;
use serde::{Deserialize, Serialize};

pub struct $type;

#[derive(Clone, Debug, Default, Serialize, Deserialize, JsonSchema)]
pub struct Params {}

impl Command for $type {
    const ID: &'static str = "$id";
    type Params = Params;

    fn meta() -> Meta {
        Meta { label: "$label", group: "$group", icon: "$icon", shortcut: "" }
    }

    fn run(_doc: &Document, _params: &Params) -> Result<Change, CommandError> {
        todo!("write the behaviour tests first")
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    cut_craft_core::contract_tests!($type);
}
EOF
# register it in the app: dependency + one line in src/commands.rs
sed -i "/^# Commands: one line per crate/a cmd-$name = { path = \"../commands/$name\" }" crates/app/Cargo.toml
sed -i "s|^    // scripts/new-command adds new commands above this line|    r.add::<cmd_${id}::$type>();\n&|" crates/app/src/commands.rs
# its help page: a header to start; write its steps, pictures and links before the pull request
printf -- '---\nreviewed: %s\nsee-also:\n---\n' "$(date +%F)" >"crates/help/pages/tools/$id.md"
echo "created $dir ($type, id \"$id\"), registered it in crates/app, and started its help page"
echo "crates/help/pages/tools/$id.md"
