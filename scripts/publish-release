#!/bin/bash
# Adds one computer's signed builds to the release for TAG, making the release first if no
# other computer's build has yet. Linux, Windows and macOS are built apart (the three
# "Builds" workflows), and whichever finishes first publishes the release; the others add
# their files to it as they finish. A computer's failed build holds back no one else's.
#
#   scripts/publish-release TAG DIR      (GH_TOKEN and GITHUB_REPOSITORY from the workflow)
#
# Signatures go up before the files they sign, so a file is never on the release without
# its .minisig. The updater (crates/updater) offers a computer a release only once that
# computer's own file and signature are both there; until then it offers the one before.
set -euo pipefail
tag=${1:?usage: scripts/publish-release TAG DIR}
dir=${2:?usage: scripts/publish-release TAG DIR}
repo=(-R "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is not set}")

shopt -s nullglob
files=()
for f in "$dir"/*; do
  [[ -f $f && $f != *.minisig ]] && files+=("$f")
done
if [[ ${#files[@]} == 0 ]]; then
  echo "::error::Nothing to publish in $dir"
  exit 1
fi
for f in "${files[@]}"; do
  if [[ ! -f $f.minisig ]]; then
    echo "::error::$(basename "$f") is not signed: run scripts/sign-release first"
    exit 1
  fi
done

if gh release view "$tag" "${repo[@]}" >/dev/null 2>&1; then
  echo "$tag is already published: adding these files to it"
elif gh release create "$tag" "${repo[@]}" --verify-tag --title "Cut Craft $tag" --generate-notes; then
  echo "published $tag"
elif gh release view "$tag" "${repo[@]}" >/dev/null 2>&1; then
  # another computer's build made it a moment ago
  echo "$tag was published meanwhile: adding these files to it"
else
  echo "::error::Could not publish $tag"
  exit 1
fi

# Run again (a re-run of this computer's build): a file already there with its signature is
# left as it is, since replacing it deletes the working one first and a failed upload would
# lose it. An incomplete pair (an upload stopped part way) goes up again whole, as this
# build's signature only matches this build's file, in the order that never shows a file
# beside a signature that isn't its own: signature first, unless the old file is the half
# that is there, when the file goes first (a file with no signature is never offered).
on_release=$(gh release view "$tag" "${repo[@]}" --json assets --jq '.assets[].name')
there() { grep -qxF "$1" <<<"$on_release"; }
first=()
second=()
for f in "${files[@]}"; do
  name=$(basename "$f")
  if there "$name" && there "$name.minisig"; then
    echo "$name is already on $tag with its signature: left as it is"
  elif there "$name"; then
    first+=("$f")
    second+=("$f.minisig")
  else
    first+=("$f.minisig")
    second+=("$f")
  fi
done
if [[ ${#first[@]} == 0 ]]; then
  exit 0
fi
gh release upload "$tag" "${first[@]}" "${repo[@]}" --clobber
gh release upload "$tag" "${second[@]}" "${repo[@]}" --clobber
for f in "${first[@]}" "${second[@]}"; do
  [[ $f == *.minisig ]] || echo "attached $(basename "$f")"
done
