#!/bin/bash
# Tests for scripts/publish-release: scripts/test-publish-release (CI runs it on each pull
# request). A stand-in `gh` records what it is asked and plays a release that is or is not
# there yet, or one another build makes while this one is making it.
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failed=0
fail() {
  echo "FAIL: $*"
  failed=1
}

mkdir -p "$work/bin" "$work/dist"
cat >"$work/bin/gh" <<'GH'
#!/bin/bash
echo "$*" >>"$GH_LOG"
case "$1 $2" in
  "release view")
    [[ -f $GH_STATE/exists ]] || exit 1
    # --json assets: the names already on the release
    if [[ $* == *--json* ]]; then cat "$GH_STATE/assets" 2>/dev/null || true; fi ;;
  "release create")
    if [[ -f $GH_STATE/race ]]; then touch "$GH_STATE/exists"; exit 1; fi
    [[ -f $GH_STATE/exists ]] && exit 1
    touch "$GH_STATE/exists" ;;
  "release upload") [[ ! -f $GH_STATE/upload-fails ]] ;;
  # the tags of the releases already out, newest first, as GitHub lists them
  "release list") cat "$GH_STATE/releases" 2>/dev/null || true ;;
esac
GH
chmod +x "$work/bin/gh"

run() { # state... : runs publish-release with a fresh log, in the given state
  rm -rf "$work/state" "$work/log"
  mkdir -p "$work/state"
  for s in "$@"; do touch "$work/state/$s"; done
  PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
    "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1
}
log() { cat "$work/log" 2>/dev/null; }

touch "$work/dist/cut-craft-1.2.3-windows-x86_64.zip"
touch "$work/dist/cut-craft-1.2.3-windows-x86_64.zip.minisig"

# the first build to finish publishes the release
run || fail "first: failed: $(cat "$work/out")"
log | grep -q "^release create v1.2.3 -R o/r --verify-tag" || fail "first: no create: $(log)"

# a later build adds to it and makes nothing
run exists || fail "later: failed: $(cat "$work/out")"
log | grep -q "release create" && fail "later: made the release again: $(log)"
log | grep -q "release upload v1.2.3 .*windows-x86_64.zip -R o/r --clobber" \
  || fail "later: did not upload: $(log)"

# two at once: this one's create loses, and it adds to the other's
run race || fail "race: failed: $(cat "$work/out")"
log | grep -q "release upload" || fail "race: did not upload: $(log)"

# signatures go up before the files they sign
first_upload=$(log | grep -m1 "release upload")
[[ $first_upload == *.minisig* && $first_upload != *".zip -R"* ]] \
  || fail "the first upload is not the signatures alone: $first_upload"

# published before (a re-run): a file and its signature already there are left alone, never
# deleted and uploaded again, which could lose a working download if the upload failed
rm -rf "$work/state" "$work/log"; mkdir -p "$work/state"; touch "$work/state/exists"
printf '%s\n' cut-craft-1.2.3-windows-x86_64.zip cut-craft-1.2.3-windows-x86_64.zip.minisig >"$work/state/assets"
PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
  "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1 || fail "complete pair: failed: $(cat "$work/out")"
log | grep -q "release upload" && fail "complete pair: uploaded again: $(log)"
grep -q "already" "$work/out" || fail "complete pair: did not say it was already there: $(cat "$work/out")"
# only the signature got there last time: both go up again, signature first
printf '%s\n' cut-craft-1.2.3-windows-x86_64.zip.minisig >"$work/state/assets"
rm -f "$work/log"
PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
  "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1 || fail "half pair: failed: $(cat "$work/out")"
[[ $(log | grep -c "release upload") == 2 ]] || fail "half pair: not signature then file: $(log)"

# only the file got there (its signature was lost): the new file goes up before its
# signature, so the old file is never shown beside this build's signature
printf '%s\n' cut-craft-1.2.3-windows-x86_64.zip >"$work/state/assets"
rm -f "$work/log"
PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
  "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1 || fail "file only: failed: $(cat "$work/out")"
first_upload=$(log | grep -m1 "release upload")
[[ $first_upload == *".zip -R"* ]] || fail "file only: signature went up before the file: $(log)"

# a failed upload fails the step
run exists upload-fails && fail "a failed upload passed"

# an unsigned file is never published
touch "$work/dist/cut-craft-1.2.3.dmg"
run exists && fail "an unsigned file was published"
log | grep -q "release upload" && fail "uploaded with an unsigned file there: $(log)"
rm "$work/dist/cut-craft-1.2.3.dmg"

# a newer release is already out: this older version is skipped for these files (they ship
# with the newer one), and nothing is made or uploaded
rm -rf "$work/state" "$work/log"; mkdir -p "$work/state"; touch "$work/state/exists"
printf '%s\n' v1.2.10 v1.2.3 v1.2.2 >"$work/state/releases"
PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
  "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1 || fail "newer out: failed: $(cat "$work/out")"
log | grep -qE "release (create|upload)" && fail "newer out: published the older version: $(log)"
grep -q "v1.2.10 is already out" "$work/out" || fail "newer out: did not say why: $(cat "$work/out")"
# only older ones out (and odd tags that are not versions): published as usual
printf '%s\n' v1.2.3 v1.2.2 depth-v9 nightly >"$work/state/releases"
rm -f "$work/log"
PATH="$work/bin:$PATH" GH_LOG="$work/log" GH_STATE="$work/state" GITHUB_REPOSITORY=o/r \
  "$here/publish-release" v1.2.3 "$work/dist" >"$work/out" 2>&1 || fail "older out: failed: $(cat "$work/out")"
log | grep -q "release upload" || fail "older out: did not upload: $(log)"

# nothing built: nothing to publish
rm "$work/dist"/*
run exists && fail "an empty folder passed"

# one publisher per computer and tag: a pushed tag and the same tag started by hand share a
# concurrency group (GitHub runs them one after the other), so two never upload one file
for os in linux windows macos; do
  wf="$here/../.github/workflows/builds-$os.yml"
  grep -qxF "  group: builds-$os-\${{ inputs.tag || github.ref_name }}" "$wf" \
    || fail "builds-$os.yml: a pushed tag and a started one don't share a concurrency group"
done

# each computer's own tests pass before its files are published
for os in linux windows macos; do
  wf="$here/../.github/workflows/builds-$os.yml"
  awk '/^  release:/{r=1} r&&/needs:/{print; exit}' "$wf" | grep -q tests \
    || fail "builds-$os.yml: publishes without waiting for its own tests"
done

if [[ $failed == 0 ]]; then echo "publish-release: all tests pass"; fi
exit $failed
