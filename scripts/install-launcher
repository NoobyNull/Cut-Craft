#!/bin/bash
# Build Cut Craft for release and put it in the desktop's application menu.
#   scripts/install-launcher           build, then install or update the launcher
#   scripts/install-launcher --remove  take the launcher out again
# The launcher runs this checkout's target/release/cut-craft from the repository folder,
# where the app finds assets/icons. Re-run after pulling changes to rebuild.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
repo=$(pwd)
data="${XDG_DATA_HOME:-$HOME/.local/share}"
entry="$data/applications/cut-craft.desktop"
icon="$data/icons/hicolor/scalable/apps/cut-craft.svg"

refresh() {
    command -v update-desktop-database >/dev/null && update-desktop-database -q "$data/applications" || true
    command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 >/dev/null 2>&1 || true
}

if [[ ${1:-} == --remove ]]; then
    rm -f "$entry" "$icon"
    refresh
    echo "removed the Cut Craft launcher"
    exit
fi

cargo build --release -p cut-craft
mkdir -p "$(dirname "$entry")" "$(dirname "$icon")"
install -m 644 assets/cut-craft.svg "$icon"
# StartupWMClass matches the app id the window reports (APP_ID in crates/app/src/app.rs)
cat >"$entry" <<EOF
[Desktop Entry]
Type=Application
Name=Cut Craft
GenericName=CNC Design and Toolpaths
Comment=Design in 2D and 3D and make CNC toolpaths
Exec="$repo/target/release/cut-craft"
Path=$repo
Icon=cut-craft
Terminal=false
Categories=Graphics;Engineering;
Keywords=CNC;CAD;CAM;router;toolpath;vcarve;
StartupWMClass=cut-craft
EOF
command -v desktop-file-validate >/dev/null && desktop-file-validate "$entry"
refresh
echo "installed $entry"
