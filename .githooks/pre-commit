#!/bin/bash
# Validation gate: formatting, lints (warnings are errors), tests. Run by git before each
# commit; run it by hand any time with: .githooks/pre-commit
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo nextest run --workspace --all-features --no-tests=pass
