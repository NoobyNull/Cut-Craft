# src/app/placement.rs
placement-no-3d-model-yet-the = No 3D model yet: the gap is used once there is one
placement-the-model-s-highest-point = The model's highest point flush with the top of the material (Gap Above Model, 0)
placement-the-model-s-lowest-point = The model's lowest point on the bottom of the material (Gap Below Model, 0)
placement-top-at-material-top = ⬆ Top at material top
placement-bottom-on-material-bottom = ⬇ Bottom on material bottom
placement-gap-above = Gap above the model: { $gap }
placement-gap-below = Gap below the model: { $gap }
placement-reset-rotation = ↺ Reset rotation
    .tooltip = Turn the model back to how its file has it: its top up and every turn (X, Y and Z) back to 0. Nothing is imported yet, so this needs no Undo
placement-reset-position = ⌖ Reset position
    .tooltip = Put the model back where it first came in: centred on the material and sitting on the zero plane (in a rotary job, on the axis). Nothing is imported yet, so this needs no Undo
placement-reset-nothing = It is already there: nothing to put back
