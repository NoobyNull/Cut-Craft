# The Design and Toolpaths pages' sub-tabs (the Ribbon and Classic layouts' rows of tabs over
# the tools), each with its tooltip (.hint): what its tools are for.

design-subtab-create = Create
    .hint = Draw shapes, lines, curves and text
design-subtab-edit = Edit
    .hint = Select, reshape, join, trim, move, rotate and resize what you drew
design-subtab-arrange = Arrange
    .hint = Line things up, space them out, offset them, nest them and make copies
design-subtab-model = Model
    .hint = Build and shape the 3D parts to carve
design-subtab-import = Import
    .hint = Bring in drawings, pictures, 3D models, clipart, toolpaths and cut lists
toolpaths-subtab-create = Create
    .hint = Pick how to cut: each button makes a toolpath from the vectors or model you selected
toolpaths-subtab-preview = Preview
    .hint = Watch the toolpaths cut the material
toolpaths-subtab-analyse = Analyse
    .hint = Check the toolpaths before cutting: what would stop or spoil the cut, what is out of date, and how long each takes
toolpaths-subtab-output = Output
    .hint = Write the file your machine runs or send it there, and the sheets and labels that go with it

