# Names a screen reader reads out for controls that a sighted person names by what is drawn
# beside them.

# A number box: its setting's name, then the unit it is in ("Cut Depth, mm").
number-box-name = { $name }, { $unit }
# The small up and down buttons beside a number box.
number-box-increase = Increase { $name }
number-box-decrease = Decrease { $name }
