backup-no-settings-folder = there is no settings folder on this computer
backup-kept-heading = Backups kept
backup-none-yet = None yet. Cut Craft makes one before the next big change.
backup-size = { $megabytes } MB
backup-reason-by-hand = Saved by you
backup-reason-before-update = Before an update
backup-reason-before-layout-change = Before changing the window layout
backup-reason-before-setup = Before first-time setup
backup-reason-before-library-change = Before Cut Craft changed a library
