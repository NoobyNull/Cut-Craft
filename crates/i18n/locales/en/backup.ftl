# src/app/backups.rs
backup-window-title = Back Up Settings
backup-window-intro = Saves what you have set up in Cut Craft in one backup file, to keep somewhere safe or take to another computer. Tick the parts to put in.
backup-part-settings = Settings and window layout
    .tooltip = Everything in Edit ▸ Options, the window layout, your favourite tools and Job Defaults
backup-part-machines = Machines and post processors
    .tooltip = Your machines from Machine Configuration, and the post processors you added
backup-part-bit-library = Bit Library
    .tooltip = Your bits, their groups and their cutting data
backup-part-materials = Materials Library
    .tooltip = The materials and their settings
backup-part-templates = Templates
    .tooltip = Your job, toolpath and form settings templates
backup-part-brushes = Brushes, textures and fonts
    .tooltip = Sculpting brushes, textures and fonts you added
backup-part-gadgets = My Gadgets
    .tooltip = The gadgets you added
backup-part-library = Library folders and tags
    .tooltip = The folders the Library looks in, and the tags you gave its files
backup-part-words = Spelling words
    .tooltip = The words you added to the spelling list
backup-part-add-ons = Add-ons list
    .tooltip = Which add-ons are installed and where each came from. The add-ons themselves are not copied: they are downloaded again
backup-part-unsigned-allowed = Unsigned code you allowed
