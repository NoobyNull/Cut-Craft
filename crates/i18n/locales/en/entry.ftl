entry-as-set-before-entry-modes = (as set before entry modes)
entry-across-the-circle-the-bit = Across the circle the bit's centre goes round, as a share of the bit
entry-angle = Angle
entry-diameter = Diameter
entry-distance = Distance
entry-each-leg = Each leg
entry-each-place-the-bit-goes = Each place the bit goes down fits this to the room it has, never steeper: a helix gets smaller, then turns into a zig-zag along the cut; a zig-zag or ramp takes shorter legs. Only where there is no room at all does it go straight down, and Checks before cutting says where.
entry-entry = Entry
entry-entry-2 = Entry:
entry-entry-3 = Entry…
entry-how-far-along-the-cut = How far along the cut it takes to go down a pass
entry-how-many-legs-to-go = How many legs to go down a pass in; there and back is two, and an odd number is made even so the bit ends where it began
entry-how-steeply-each-leg-goes = How steeply each leg goes down, from level
entry-how-steeply-it-goes-down = How steeply it goes down, from level
entry-how-the-bit-goes-down = How the bit goes down into the material each time a cut starts:
entry-how-the-bit-goes-down-2 = How the bit goes down into the material: in a helix, a zig-zag, a ramp or straight down
entry-it-slides-in-along-the = It slides in along the groove's own centre line, never deeper than the groove's width sets. Where a groove is too short for it, it goes straight down there, as a V-carve usually does.
entry-passes = Passes
entry-ramp-angle = about { $angle }° for a full pass

# The one-line summary of how the bit goes down, under Profile's and Pocket's cut settings.
entry-summary-plunge = Straight down into the material
entry-summary-helix = Helix { $across } across at { $angle }°, smaller where there is less room
entry-summary-zigzag = Zig-zag at { $angle }° in { $passes } passes ({ $legs } legs)
entry-summary-ramp = Ramp down a pass over { $distance } (about { $angle }°)
# The four ways down in the Entry window.
entry-way-helix = Helix
    .tooltip = Down in circles, like a corkscrew: the gentlest on the bit, for pockets and holes
entry-way-zigzag = Zig-zag
    .tooltip = Back and forth along the start of the cut, a little lower each time: for narrow slots and lines
entry-way-ramp = Ramp
    .tooltip = Down along the cut in one straight slope
entry-way-plunge = Straight down
    .tooltip = Like a drill: quickest, but hardest on the bit, and only for bits that cut at their centre
# What a screen reader calls the ramp's distance box.
entry-ramp-distance-name = Ramp distance
