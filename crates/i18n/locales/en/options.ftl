# Edit ▸ Options.

# The Language page.
language-english = English (built in)
# $percent: how much of Cut Craft the pack has words for, a whole number.
language-coverage = { $percent }% translated
language-not-official = ⚠ not official
    .tooltip = Not signed with Cut Craft's release key, so nobody has checked it
language-none-installed = No language packs are installed. Get one in Gadgets ▸ Add-ons, under Languages.
language-test = Test language (longer words, to check layouts)
    .tooltip = English, accented and about 40% longer, in brackets: shows where a longer language would be cut off or pushed out of place
language-fallback = Words a pack has no translation for show in English. The language changes once you press Apply.
# Options ▸ Confirmations: unsigned gadgets and add-ons the user chose Run and Remember for.
options-unsigned-heading = Unsigned gadgets and add-ons
options-unsigned-remembered = { $count ->
    [0] You have not told any unsigned gadget or add-on to run without asking.
    [one] 1 unsigned gadget or add-on runs without asking (you chose Run and Remember), until it changes.
   *[other] { $count } unsigned gadgets and add-ons run without asking (you chose Run and Remember), each until it changes.
}
options-unsigned-forget = Forget These Answers
    .tooltip = Unsigned gadgets and add-ons ask again before they next run. This happens at once, without Apply.
options-unsigned-forgotten = Unsigned gadgets and add-ons will ask again before they next run.
