# src/app/surfacing.rs
surfacing-cutting = Cutting
surfacing-cutting-2 = Cutting…
surfacing-goes-down-beside-the-work = Goes down beside the work and feeds in from the side: it never plunges
surfacing-which-way-the-bit-runs = Which way the bit runs, and back and forth or one way
surfacing-your-machine-s-bed-size = Your machine's bed size isn't set: type the spoilboard's size, or set the bed size in Machine ▸ Machines

# The choices in surfacing's Cutting window.
surfacing-choice-direction = Direction
surfacing-choice-climb = Climb
    .tooltip = The cutter's edge meets the material head on: usually the smoother finish
surfacing-choice-conventional = Conventional
    .tooltip = The other way round
surfacing-choice-rows = Rows
surfacing-choice-back-and-forth = Back and forth
    .tooltip = Each row back the way the last came, staying down: the quickest
surfacing-choice-one-way = One way
    .tooltip = Every row the direction chosen, lifting back between rows: the most even finish
# What surfacing's cutting choices make, in a line.
surfacing-said-rings = Rings from the outside in, going { $way } ({ $cut })
surfacing-said-one-way = Every row one way ({ $cut }), lifting back between rows
surfacing-said-back-and-forth = Back and forth, staying down; the first row { $cut }
