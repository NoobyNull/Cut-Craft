# The words put into the lines below: which way round, and which kind of cut.
cutting-word-clockwise = clockwise
cutting-word-anticlockwise = anticlockwise
cutting-word-climb = climb
cutting-word-conventional = conventional
# What the cutting choices make, in plain words.
cutting-headline-outside = Cuts round the outside of each shape, going { $way }
cutting-headline-inside = Cuts round the inside of each shape, going { $way }
cutting-headline-on = Cuts along the line itself, going { $way }
cutting-headline-rows = Clears the pocket in rows
cutting-headline-adaptive = Clears the pocket with a thin, steady bite, then once round the wall
cutting-headline-rings = Clears the pocket in rings, going { $way }
# What each pass does, a line each.
cutting-told-adaptive-spirals = Spirals out from the roomiest spot, cutting { $cut } all the way
cutting-told-adaptive-tighter = Turns tighter where the bite would grow, so corners are cut in thin slices
cutting-told-adaptive-wall = Then once round the wall, { $way }, for a clean edge
cutting-told-rows-keep-climb = Every row cuts { $cut }: the bit comes back through the row it just cut, then steps over along the wall without lifting
cutting-told-rows-alternate = Rows go back and forth, stepping over along the wall without lifting: one row cuts climb, the next conventional
cutting-told-first-part = Pass 1: { $cut }, { $way } round the part
cutting-told-first-hole = Pass 1: { $cut }, { $way } round the hole
cutting-told-first-line = Pass 1: { $cut }, { $way } along the line
cutting-told-first-pocket = Pass 1: { $cut }, { $way } round the pocket
cutting-told-second-loops = Pass 2: back the other way, { $way }, its loops still turning the same way; and so on
cutting-told-second = Pass 2: back the other way, { $cut }, { $way }; and so on
cutting-told-rings-outline-in = Rings from the outline in: they cut { $cut }
cutting-told-rings-alternate = Rings middle out ({ $first }), then outline in ({ $then }), pass by pass
cutting-told-rings-middle-out = Rings from the middle out: they cut { $cut }
cutting-told-loops = In loops turning { $way }: each loop cuts { $cut }
# A profile's side, said under its form.
cutting-side-inside = Cuts a hole: the bit goes round the inside of each shape, so the hole is the size drawn.
cutting-side-on = Follows the line: the middle of the bit runs along it, so the cut is as wide as the bit. Use it for open lines and grooves.
cutting-side-outside = Cuts a part out: the bit goes round the outside of each shape, so the part is the size drawn.
# The job's Clearing Settings in a line.
cutting-this-job-keeps-climb = This job: light step { $step }% ({ $bite } with this bit), keeps climb on the way back
cutting-this-job-alternates = This job: light step { $step }% ({ $bite } with this bit), alternates climb and conventional
cutting-loops-said = Loops { $across } across, each { $on } on; the cutter { $cutter }
# The choices in the Cutting window.
cutting-choice-direction = Direction
cutting-choice-climb = Climb
    .tooltip = The cutter's edge meets the material head on: clockwise round a part or along a closed line (an open line runs the way it was drawn)
cutting-choice-conventional = Conventional
    .tooltip = The other way round
cutting-choice-passes = Passes
cutting-choice-single-direction = Single direction
    .tooltip = Every pass the direction's way
cutting-choice-both-directions = Both directions
    .tooltip = Each pass back the way the last came
cutting-choice-rings = Rings
cutting-choice-middle-out = From the middle out
    .tooltip = Cut the direction chosen
cutting-choice-outline-in = From the outline in
    .tooltip = Cut the other direction
cutting-choice-alternate = Alternate
    .tooltip = Middle out, then outline in, pass by pass
cutting-choice-motion = Motion
cutting-choice-straight = Straight
    .tooltip = Along the path, the cutter's whole side cutting
cutting-choice-trochoidal = Trochoidal
    .tooltip = In small loops, a sliver of the edge cutting
