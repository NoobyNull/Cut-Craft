# The main window: its pages, the tool forms' shared rows and the windows they open.

# A page's title row.
page-pin = Закрепить эту страницу открытой
page-unpin = Открепить: свернуть эту страницу в боковую вкладку
page-switch-layout = Сменить компоновку (F11 — дизайн, F12 — обработка)
page-help = Справка (F1)
# $hint: what the sub-tab holds, a sentence with no full stop.
subtab-in-row = { $hint }. Щёлкните правой кнопкой, чтобы показать как отдельный раздел
subtab-as-section = { $hint }. Щёлкните правой кнопкой, чтобы вернуть в ряд вкладок
# $tab: the tab's name.
tab-not-implemented = Инструменты «{ $tab }» пока не реализованы

# The start page's link to the community. $site is a site's name, such as GitHub.
start-community-link = PowerWhittle на { $site }

# Rows a tool form can have.
form-next-step = Далее:
form-point-at-setting = Наведите на настройку, чтобы узнать, что она делает.
form-reset = Сбросить
    .tooltip = Вернуть все настройки к значениям по умолчанию и построить заново, как новую
form-new-shape = Новая фигура
    .tooltip = Оставить эту фигуру как есть и ввести размеры для другой
form-save-settings = Сохранить настройки…
    .tooltip = Сохранить настройки этой формы в файл, чтобы использовать их позже
form-load-settings = Загрузить настройки…
    .tooltip = Заполнить эту форму ранее сохранёнными настройками
form-calculate-as-new = Рассчитать как новую
    .tooltip = Добавить ещё одну траекторию с этими настройками, сохранив уже созданную

# A shape drawn more than one way: the choice at the top of its form.
form-way-caption = Рисовать от:
form-way-corner = Угла
form-way-center = Центра
form-way-edge = Края
form-way-corner-hint = Тяните от одного угла к противоположному
form-way-center-rectangle-hint = Тяните от середины к углу — одинаково в каждую сторону
form-way-center-circle-hint = Тяните от середины к краю
form-way-edge-hint = Тяните от одной стороны прямо к другой
# A shape's button, while its other ways are picked in its form. $ways: their names, such as Corner / Center.
form-way-tooltip = Рисовать от: { $ways }. Выберите способ в «Рисовать от» вверху формы.

# Toolpaths left out of date by an edit. $message is what the edit said in the status bar.
recalculate-out-of-date = { $count ->
    [one] { $message }. { $count } траектория устарела (⚠ в списке траекторий): пересчитайте её и заново сохраните G-code, если уже сохраняли
    [few] { $message }. { $count } траектории устарели (⚠ в списке траекторий): пересчитайте их и заново сохраните G-code, если уже сохраняли
    [many] { $message }. { $count } траекторий устарели (⚠ в списке траекторий): пересчитайте их и заново сохраните G-code, если уже сохраняли
   *[other] { $message }. { $count } траектории устарели (⚠ в списке траекторий): пересчитайте их и заново сохраните G-code, если уже сохраняли
}
recalculate-ask-title = Траектории устарели
recalculate-ask = { $count ->
    [one] { $count } траектория устарела: векторы, по которым она режет, изменились. Пересчитать все траектории сейчас, чтобы сохранённый G-code совпадал с чертежом?
    [few] { $count } траектории устарели: векторы, по которым они режут, изменились. Пересчитать все траектории сейчас, чтобы сохранённый G-code совпадал с чертежом?
    [many] { $count } траекторий устарели: векторы, по которым они режут, изменились. Пересчитать все траектории сейчас, чтобы сохранённый G-code совпадал с чертежом?
   *[other] { $count } траектории устарели: векторы, по которым они режут, изменились. Пересчитать все траектории сейчас, чтобы сохранённый G-code совпадал с чертежом?
}
recalculate-dont-ask = Больше не спрашивать
    .tooltip = Отключить этот вопрос (Параметры ▸ Выбор подтверждений включает его снова). Устаревшие траектории по-прежнему помечены ⚠, а при их сохранении всё равно будет вопрос
recalculate-all = Пересчитать все
    .tooltip = Сейчас же заново построить каждую устаревшую траекторию по её векторам
recalculate-not-now = Не сейчас
    .tooltip = Оставить их помеченными ⚠ в списке траекторий; «Пересчитать все» доступно, когда понадобится

# A new toolpath order left toolpaths that cut only what is above them out of date. $names lists them.
reorder-ask-title = Устарели после нового порядка
reorder-ask = { $count ->
    [one] { $names } режет только то, что оставляют траектории выше, а они теперь другие: она устарела (⚠), пока её не пересчитают. Вернуть прежний порядок?
    [few] { $names } режут только то, что оставляют траектории выше, а они теперь другие: они устарели (⚠), пока их не пересчитают. Вернуть прежний порядок?
    [many] { $names } режут только то, что оставляют траектории выше, а они теперь другие: они устарели (⚠), пока их не пересчитают. Вернуть прежний порядок?
   *[other] { $names } режут только то, что оставляют траектории выше, а они теперь другие: они устарели (⚠), пока их не пересчитают. Вернуть прежний порядок?
}
reorder-put-back = Вернуть
    .tooltip = Отменить новый порядок: всё вернётся на свои места и будет актуальным, как раньше
reorder-keep = Оставить новый порядок
    .tooltip = Оставить его и пересчитать траектории с пометкой ⚠, когда будете готовы
reorder-put-back-done = Прежний порядок восстановлен

# Draw Text's spelling check.
spelling-title = Орфография
spelling-no-dictionary = Орфография: словарь не найден (положите файлы Hunspell .dic и .aff в папку словарей PowerWhittle)
spelling-none-wrong = Орфографических ошибок нет
spelling-add-word = Добавить слово
spelling-remove-word = Удалить слово
spelling-a-word-added = добавлено слово…

# Import 3D Model's buttons and placing.
import-model-cancel = Отмена
    .tooltip = Закрыть, не импортируя модель (Esc делает то же самое)
import-model-import = Импорт
    .tooltip = Оставить модель так, как она размещена
    .waiting = Пока ничего не размещено: меняйте настройки выше, пока модель не появится, или нажмите «Отмена»
align-in-material = Выровнять в материале
align-height = Высота
undercuts-update = Обновить поднутрения
    .tooltip = Заново определить, куда не достаёт фреза сверху
    .disabled = Сначала отметьте «Подсвечивать поднутрения»
scale-to-fit = Вписать в материал
    .tooltip = Сделать модель настолько большой, насколько позволяет материал, при текущем повороте. Выполняется один раз: последующий поворот модели сохраняет её размер
    .disabled = Сначала отметьте «Изменить размер» в разделе «Размер модели»

# Sculpting's brushes.
sculpt-load-brush = Загрузить кисть…
    .tooltip = Компонент, сохранённый как кисть для лепки, для «Наращивания» и «Удаления»
sculpt-round-brush = Круглая кисть

# Texture Toolpath's files.
texture-load = Загрузить текстуру...
    .tooltip = Ранее сохранённая текстура из папки текстур или из любого места
texture-save = Сохранить текстуру...
    .tooltip = Сохранить эти настройки текстуры, чтобы использовать их снова

# A photo's depth, for turning it into a relief.
depth-title = Глубина
depth-from-picture = Само изображение используется как карта глубины (белое — ближе всего), поэтому оценка не нужна. Отметьте «Инвертировать», если ближе всего чёрное.
depth-needs-addon = Чтобы превратить фото в рельеф, нужно бесплатное дополнение Depth (около 100 МБ, скачивается один раз). Если изображение уже является картой глубины, выберите в «Глубина из» вариант «Изображение».
depth-estimating = Оценка глубины… (до минуты для большого фото)
depth-has-depth = Глубина этого фото уже есть. После правки фото оцените её заново.
depth-estimate-first = Сначала оцените, насколько далеко каждая часть фото от камеры.
depth-estimate = Оценить глубину
    .tooltip = Вычисляет глубину фото на этом компьютере; ничего не загружается в сеть
    .disabled = Сначала импортируйте фото
depth-downloading-high-detail = Скачивание модели высокой детализации (около 670 МБ)...
depth-high-detail = Высокая детализация
depth-high-detail-note = Медленнее и только для личного некоммерческого использования.
depth-want-finer = Нужно больше деталей? Бесплатная модель высокой детализации (около 670 МБ, скачивается один раз) видит больше, но работает медленнее и предназначена только для личного некоммерческого использования.
depth-get-high-detail = Получить модель высокой детализации
depth-addon-finding = Поиск новейшего дополнения Depth...
depth-addon-downloading = Скачивание дополнения Depth...
depth-addon-asking = Окно «Дополнения» спрашивает, устанавливать ли его.
depth-addon-install = Установить дополнение Depth
    .tooltip = Скачивается с GitHub один раз; Гаджеты ▸ Дополнения обновляет его
    .disabled = У PowerWhittle нет папки настроек, куда его поместить

# Generate Border: a repeating border made with the Borders add-on and the person's own Google key.
border-google-title = Ваш ключ Google
border-sent-to-google = «Создать» отправляет стиль и ваши «Подробности» в Google, который рисует рамку и выставляет счёт на ваш собственный аккаунт Google. Больше ничего из вашего задания не отправляется.
border-key = Ключ Google
    .tooltip = Ваш собственный API-ключ Google AI Studio. Он хранится в хранилище паролей этого компьютера, а не в ваших заданиях или настройках
border-save-key = Сохранить ключ
    .tooltip = Сохранить этот ключ в хранилище паролей этого компьютера на следующий раз
border-key-saved = Ключ сохранён в хранилище паролей этого компьютера.
border-key-saved-file = На этом компьютере нет хранилища паролей, поэтому ключ сохранён в личном файле в папке настроек PowerWhittle.
border-key-kept = Ваш ключ Google сохранён на этом компьютере.
border-forget-key = Забыть ключ
    .tooltip = Удалить ключ с этого компьютера. Его можно ввести снова в любое время
border-get-key = Получить бесплатный ключ Google
border-needs-key = Сначала введите ключ Google выше и нажмите «Сохранить ключ». Бесплатно его можно получить в Google AI Studio.
border-needs-addon = Для «Создать рамку» нужно бесплатное дополнение Borders (около 5 МБ, скачивается один раз).
border-needs-depth-addon = В «Глубина из» выбрано дополнение Depth, но оно не установлено. Установите его через Гаджеты ▸ Дополнения или выберите в «Глубина из» вариант Google.
border-no-documents = На этом компьютере нет папки «Документы», чтобы сохранить рамку.
border-addon-install = Установить дополнение Borders
    .tooltip = Скачивается с GitHub один раз; Гаджеты ▸ Дополнения обновляет его
border-addon-installing = Установка дополнения Borders...
border-asking-picture = Google рисует рамку... (около полминуты)
border-asking-depth = Вычисление её глубины...
border-saving = Сохранение в вашу библиотеку...
border-saved = «{ $name }» сохранено в вашей библиотеке в разделе Созданные ▸ Рамки. Дважды щёлкните там, чтобы поместить в чертёж.

# Help ▸ Keyboard Shortcuts.
shortcuts-change = Изменить сочетания…
    .tooltip = Назначьте свои клавиши, боковые кнопки мыши и нажатие колеса в Параметры ▸ Мышь и сочетания клавиш

# Help ▸ Credits.
credits-intro = PowerWhittle создан с помощью бесплатных библиотек, изображений и значков, сделанных другими людьми. Спасибо им всем. У каждого своя лицензия, приведённая здесь полностью: щёлкните строку, чтобы прочитать её.
credits-search = Поиск по названию библиотеки или лицензии
credits-showing = Показано { $shown } из { $total }
credits-none = Ничего не найдено по запросу «{ $search }». Попробуйте часть названия библиотеки, например serde, или лицензию, например MIT.
credits-more = { $names } и ещё { $count }

# Help ▸ About.
about-name = PowerWhittle
about-version = Версия { $version }
about-what = 2D- и 3D-дизайн и траектории для ЧПУ.
about-license = Лицензия
about-read-license = Прочитать лицензию полностью
about-acknowledgements = Благодарности
about-credits = Благодарности…
    .tooltip = Библиотеки, изображения и значки, с помощью которых создан PowerWhittle, и их лицензии
about-contributors = Участники на GitHub
about-commits = { $count ->
    [one] { $count } коммит
    [few] { $count } коммита
    [many] { $count } коммитов
   *[other] { $count } коммита
}
lathe-a-speed = Ближе всего к оси (на расстоянии { $radius }) A вращается со скоростью { $rate }°/мин, чтобы сохранить там подачу фрезы { $feed }/мин.
lathe-a-speed-capped = Ближе всего к оси (на расстоянии { $radius }) оси A нужно { $rate }°/мин, чтобы сохранить подачу фрезы { $feed }/мин, но этот станок вращает A не быстрее { $most }°/мин: в пределах { $slow } от оси фреза режет медленнее своей подачи, и стружка становится тоньше. Меньшая подача или более толстый держащий хвостовик это исправят.
