machines-showing = Показано { $shown } из { $total }
machines-delete-post = Удалить { $name }? Его файл будет удалён, это нельзя отменить.
machines-post-renamed = { $name } переименован: в станках, использующих { $old }, его нужно выбрать заново
machines-post-will-not-load = Не загружается: { $why }
machines-centre-line = Осевая линия { $across }
machines-centre-line-hint = Расстояние от нуля заготовки до оси вращения по { $across }. Обычно 0, если ноль { $across } выставлен на оси. (Высота берётся из Настройки задания: ноль Z на оси вращения или на верху материала)
machines-bit-changes = { $grouped ->
    [yes] Смена фрез: { $how }, сгруппировано по фрезам
   *[no] Смена фрез: { $how }
    }
machines-both-arms = { $name } (оба плеча)
