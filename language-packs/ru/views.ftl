views-labels-count = { $count ->
    [one] Этикетку получит { $count } деталь. Называйте детали через Правка ▸ Назвать деталь.
    [few] Этикетки получат { $count } детали. Называйте детали через Правка ▸ Назвать деталь.
    [many] Этикетки получат { $count } деталей. Называйте детали через Правка ▸ Назвать деталь.
   *[other] Этикетки получат { $count } детали. Называйте детали через Правка ▸ Назвать деталь.
    }
views-tiling-on = { $tiles ->
    [one] Разбиение включено: { $tiles } часть. Каждая часть сохраняется отдельным файлом с вашим именем и добавкой от _tile1 до _tile{ $tiles } (для части, где нечего резать, файла нет). Отключается в Траектории ▸ Разбиение траекторий на части
    [few] Разбиение включено: { $tiles } части. Каждая часть сохраняется отдельным файлом с вашим именем и добавкой от _tile1 до _tile{ $tiles } (для части, где нечего резать, файла нет). Отключается в Траектории ▸ Разбиение траекторий на части
    [many] Разбиение включено: { $tiles } частей. Каждая часть сохраняется отдельным файлом с вашим именем и добавкой от _tile1 до _tile{ $tiles } (для части, где нечего резать, файла нет). Отключается в Траектории ▸ Разбиение траекторий на части
   *[other] Разбиение включено: { $tiles } части. Каждая часть сохраняется отдельным файлом с вашим именем и добавкой от _tile1 до _tile{ $tiles } (для части, где нечего резать, файла нет). Отключается в Траектории ▸ Разбиение траекторий на части
    }
